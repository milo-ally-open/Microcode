{
  "name": "microcode",
  "version": "0.1.0",
  "private": true,
  "description": "A terminal-native AI coding assistant for understanding and changing code.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run ./src/entry.ts",
    "desktop": "bun run ./src/desktop/build.ts --run",
    "desktop:build": "bun run ./src/desktop/build.ts",
    "desktop:release:windows": "bun run ./packaging/desktop/build-windows.ts",
    "build": "bun run build.ts",
    "package:cli": "bun run packaging/package-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-tui": "^0.75.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@napi-rs/keyring": "2.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chalk": "^5.5.0",
    "diff": "^9.0.0",
    "marked": "^15.0.12",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "^1.1.24",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^7.0.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.3.14",
    "electron": "44.7.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
